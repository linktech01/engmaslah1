rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['ishanews7@gmail.com', 'maxlaxmohamuud@gmail.com'] ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(projectId);
    }

    match /articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() && isValidId(articleId);
    }

    match /inquiries/{inquiryId} {
      allow read: if isAdmin();
      allow create: if isValidId(inquiryId)
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 150
                    && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 5000;
      allow update, delete: if isAdmin() && isValidId(inquiryId);
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
