{
  "entities": {
    "project": {
      "title": "Project",
      "description": "Portfolio project showcased by Eng. Maslah Mohamuud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "category": { "type": "string", "enum": ["Software", "Network", "Cybersecurity", "IT Solutions"] },
        "description": { "type": "string", "maxLength": 2000 },
        "shortDescription": { "type": "string", "maxLength": 300 },
        "imageUrl": { "type": "string", "maxLength": 1000 },
        "technologies": { "type": "array" },
        "liveUrl": { "type": "string", "maxLength": 500 },
        "githubUrl": { "type": "string", "maxLength": 500 },
        "featured": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "category", "description", "technologies"]
    },
    "article": {
      "title": "Article",
      "description": "Technical insights, network guides and software tutorials written by Eng. Maslah Mohamuud",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 200 },
        "category": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 500 },
        "content": { "type": "string", "maxLength": 20000 },
        "readTime": { "type": "string", "maxLength": 30 },
        "published": { "type": "boolean" },
        "publishedAt": { "type": "string" },
        "tags": { "type": "array" }
      },
      "required": ["title", "category", "summary", "content"]
    },
    "inquiry": {
      "title": "Inquiry",
      "description": "Contact form submissions from potential clients and partners",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "phone": { "type": "string", "maxLength": 50 },
        "subject": { "type": "string", "maxLength": 200 },
        "message": { "type": "string", "maxLength": 5000 },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["name", "email", "subject", "message"]
    }
  },
  "firestore": {
    "/projects/{projectId}": {
      "schema": "project",
      "description": "Collection of engineering projects"
    },
    "/articles/{articleId}": {
      "schema": "article",
      "description": "Collection of published technical articles"
    },
    "/inquiries/{inquiryId}": {
      "schema": "inquiry",
      "description": "Messages sent through the contact form"
    }
  }
}
